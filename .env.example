# OpenAI-compatible chat API. Do not commit real credentials.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini

# Persistent data and local embedding model.
PERSONAL_AGENT_DATA_DIR=data
PERSONAL_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PERSONAL_AGENT_EMBEDDING_DEVICE=cpu
# Optional: override individual database paths (defaults live under DATA_DIR).
# PERSONAL_AGENT_KNOWLEDGE_DB=data/knowledge.db
# PERSONAL_AGENT_RUNS_DB=data/runs.db
# PERSONAL_AGENT_CONVERSATIONS_DB=data/conversations.db

# A single API process owns this in-memory queue. Increase workers only after
# measuring LLM API capacity and host resources.
PERSONAL_AGENT_QUEUE_WORKERS=2
PERSONAL_AGENT_QUEUE_SIZE=20
PERSONAL_AGENT_CONVERSATION_TTL_HOURS=24
PERSONAL_AGENT_MINIMUM_SEMANTIC_SCORE=0.35

# Per-client submission limit (fixed window) for the single-process API.
PERSONAL_AGENT_RATE_LIMIT_PER_MINUTE=30
