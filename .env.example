# OpenAI-compatible chat API. Do not commit real credentials.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini

# Persistent data and local embedding model.
PERSONAL_AGENT_DATA_DIR=data
PERSONAL_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PERSONAL_AGENT_EMBEDDING_DEVICE=cpu
# Optional: override individual database paths (defaults live under DATA_DIR).
# PERSONAL_AGENT_KNOWLEDGE_DB=data/knowledge.db
# PERSONAL_AGENT_RUNS_DB=data/runs.db
# PERSONAL_AGENT_CONVERSATIONS_DB=data/conversations.db

# Hugging Face access for the embedding model.
# - HF_ENDPOINT: mirror for networks that cannot reach huggingface.co (e.g. China).
# - HF_HUB_OFFLINE: set to 1 only after the model is cached (e.g. in Docker images
#   that pre-download the model at build time).
HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1

# A single API process owns this in-memory queue. Increase workers only after
# measuring LLM API capacity and host resources.
PERSONAL_AGENT_QUEUE_WORKERS=2
PERSONAL_AGENT_QUEUE_SIZE=20
# Conversation memory retention: stale runs/events are cleaned every 30 minutes.
# Default 1h: visitor memory is short-lived by design; long retention invites abuse.
PERSONAL_AGENT_CONVERSATION_TTL_HOURS=1
# Capacity caps (anti-bloat / anti-abuse):
# - max active conversations: LRU-evicts the least active tabs beyond the cap.
# - max events per conversation: keeps the newest N events, prunes the oldest.
PERSONAL_AGENT_MAX_ACTIVE_CONVERSATIONS=100
PERSONAL_AGENT_MAX_EVENTS_PER_CONVERSATION=50
PERSONAL_AGENT_MINIMUM_SEMANTIC_SCORE=0.35

# Per-client submission limit (fixed window) for the single-process API.
PERSONAL_AGENT_RATE_LIMIT_PER_MINUTE=30

# Daily LLM token budget for the public serving chain (anti cost-burn).
# Placeholder 20000; adjust after measuring real usage.
PERSONAL_AGENT_DAILY_TOKEN_BUDGET=20000
