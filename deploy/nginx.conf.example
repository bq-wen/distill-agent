# Reverse proxy for distill-agent (single uvicorn worker on 127.0.0.1:8000)

server {
    listen 80;
    server_name YOUR_DOMAIN;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # long LLM turns
    }

    # coarse per-IP protection (the app also rate-limits per client)
    limit_req_zone $binary_remote_addr zone=pa:10m rate=30r/m;
    limit_req zone=pa burst=10 nodelay;
}
